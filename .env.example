# Required: API bearer token. Must match OpenWebUI EXTERNAL_DOCUMENT_LOADER_API_KEY when using /process.
API_TOKEN=change-me

# Optional legacy alias for OpenWebUI-era deployments. API_TOKEN is preferred.
#ENGINE_API_KEY=change-me

# Optional server defaults used by run.sh.
#HOST=0.0.0.0
#PORT=8088

# Optional PDF page selection: all, 1, 1-5, 1,3,5.
#PDF_PAGES=all

# Optional chunking defaults.
#MAX_DOC_CHARS=6000
#OVERLAP_CHARS=800
#MAX_TEXT_PAGES=200

# Optional extractor tuning.
# Use fast to stop after the first extractor that finds tables.
# Use quality to run all extractors and deduplicate results, which is slower.
#PDF_TABLE_STRATEGY=fast
#PDF_TABLE_EXTRACTORS=camelot_lattice,camelot_stream,pdfplumber
#MAX_HEADER_ROWS=4
#EXTRACTOR_WORKERS=3
#CAMELOT_LATTICE_LINE_SCALE=40
#CAMELOT_STREAM_EDGE_TOL=200
#CAMELOT_STREAM_ROW_TOL=10
#MIN_ROWS_FOR_TABLE=2
#MIN_COLS_FOR_TABLE=2

# Optional Apache Tika fallback for non-PDF formats.
#TIKA_URL=http://127.0.0.1:9998
#TIKA_TIMEOUT_S=30
